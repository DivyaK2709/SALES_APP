# ── Server ──────────────────────────────────────────────
# 80 requires admin privileges on Windows — 3000 avoids that for local testing.
# You can switch back to 80 later once this runs as a proper Windows service.
PORT=3000
JWT_SECRET=change_this_to_a_long_random_string

# ── SQL Server connection (your existing DB — unchanged) ─
DB_SERVER=103.211.203.145
DB_PORT=1433
DB_DATABASE=master
DB_USER=administrator
DB_PASSWORD=REPLACE_WITH_YOUR_SQL_LOGIN_PASSWORD
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# ── CORS (comma separated origins allowed to call this API) ─
CORS_ORIGIN=*

# ── Sync agent shared secret ────────────────────────────
# Must match SYNC_SECRET_KEY in sync-agent/.env exactly. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SYNC_SECRET_KEY=change_this_to_a_long_random_string
