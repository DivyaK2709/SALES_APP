# ── This store's identity ─────────────────────────────────
# The CCode value that identifies THIS store in the cloud database.
# Every row pushed to the cloud gets tagged with this. When you add a
# second store later, give it a different STORE_CODE (e.g. 2) and point
# it at its own local database — the cloud side needs no changes.
STORE_CODE=1

# ── Local SQL Server (the store's own database — same one your ────
# ── accounting software writes to) ─────────────────────────────────
# This agent runs on the SAME PC as the SQL Server, so use 'localhost'.
LOCAL_DB_SERVER=localhost

# OPTION A — connect by named instance (needs SQL Server Browser service
# running — Windows Services app, look for "SQL Server Browser", start it
# and set it to Automatic if it's stopped):
LOCAL_DB_INSTANCE=SQLEXPRESS
# LOCAL_DB_PORT=            <- leave this blank/commented when using Option A

# OPTION B — connect by fixed port instead (more reliable, skips the
# Browser service entirely). To find your real port: SQL Server
# Configuration Manager → SQL Server Network Configuration → Protocols for
# SQLEXPRESS → TCP/IP → IP Addresses tab → scroll to "IPAll" → TCP Port.
# If you set this, comment out LOCAL_DB_INSTANCE above instead.
# LOCAL_DB_PORT=1433

LOCAL_DB_DATABASE=ynot
LOCAL_DB_USER=sync_reader
LOCAL_DB_PASSWORD=REPLACE_WITH_LOCAL_SQL_LOGIN_PASSWORD
LOCAL_DB_ENCRYPT=false
LOCAL_DB_TRUST_SERVER_CERT=true

# ── Cloud API (the freshmart-backend server) ───────────────────────
CLOUD_API_URL=http://localhost:3000
# Must match SYNC_SECRET_KEY in freshmart-backend/.env exactly.
SYNC_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_STRING
